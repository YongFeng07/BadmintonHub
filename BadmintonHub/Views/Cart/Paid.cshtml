@model List<BadmintonHub.Models.Reservation>
@{
    ViewData["Title"] = "Payment Complete";
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<div class="mt-3">
    <div class="bh-form-section text-center py-4">
        <div style="font-size: 3rem;">✅</div>
        <h1 class="h3 mt-2 mb-1">Payment Complete</h1>
        <p class="text-muted mb-3">Your bookings are confirmed. See you on the court!</p>
        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Reservations" asp-action="MyReservations" class="btn btn-bh">View My Reservations</a>
            <a asp-controller="Courts" asp-action="Index" class="btn btn-outline-secondary">Browse More Courts</a>
        </div>
    </div>

    <div class="bh-form-section mt-3">
        <h2 class="h6 text-uppercase text-muted mb-3">Confirmed bookings</h2>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Court</th>
                        <th>Facility</th>
                        <th>Date &amp; Time</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id"
                                   class="fw-bold text-decoration-none">@r.ReservationReference</a>
                            </td>
                            <td>Court @r.Court?.CourtNumber</td>
                            <td>@r.Court?.Facility?.Name</td>
                            <td class="small text-nowrap">
                                @r.ReservationDate.ToString("dd MMM yyyy") ·
                                @r.StartTime.ToString("HH:mm") – @r.EndTime.ToString("HH:mm")
                            </td>
                            <td class="text-end fw-bold text-bh-green">
                                RM @(r.Payment?.Amount.ToString("0.00") ?? "0.00")
                            </td>
                            <td class="text-end"><span class="badge bg-success">Confirmed</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
