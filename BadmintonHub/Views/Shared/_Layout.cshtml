<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BadmintonHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bh-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="bh-brand-icon">🏸</span>BadmintonHub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Index">Courts</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Facility" asp-action="Index">Facility</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Reservations" asp-action="MyReservations">My Reservations</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-lg-2 mt-1 mt-lg-0">
                                <a class="btn btn-bh-amber btn-sm px-3" asp-controller="Reservations" asp-action="Create">+ Book a Court</a>
                            </li>
                            <li class="nav-item me-lg-2 mt-1 mt-lg-0">
                                @await Component.InvokeAsync("NotificationBell")
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Reservations" asp-action="MyReservations">📋 My Reservations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">💳 My Payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">🔔 Notifications</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">👤 Profile &amp; Password</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="AdminFacility" asp-action="Edit">🏛️ Facility Settings</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminCourts" asp-action="Index">🏸 Manage Courts</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminAvailability" asp-action="Index">🗓️ Manage Availability</a></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">👥 User Accounts</a></li>
                                        }
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">🚪 Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item ms-lg-2 mt-1 mt-lg-0">
                                <a class="btn btn-bh-amber btn-sm px-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
                    @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="bh-footer mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h6>🏸 BadmintonHub</h6>
                    <p class="mb-1">Badminton Court Reservation &amp; Facility Management System</p>
                    <p class="mb-0 small">AMIT2014 Web and Mobile Systems — assignment demo system.</p>
                </div>
                <div class="col-md-3">
                    <h6>Quick Links</h6>
                    <a asp-controller="Courts" asp-action="Index" class="d-block">Browse Courts</a>
                    <a asp-controller="Facility" asp-action="Index" class="d-block">About the Facility</a>
                </div>
                <div class="col-md-3">
                    <h6>Contact</h6>
                    <span class="d-block">03-4142 8899</span>
                    <span class="d-block">info@badmintonhub.my</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
