@inject IViewLocalizer Localizer
@* DNTCaptcha.Core image captcha (revised spec). Rendered as img + text box + refresh link.
   Validation happens in ValidateCaptchaAttribute on the POST action; the asp-validation-error-message
   shows whenever ModelState["CaptchaInputText"] has an error. *@
<div class="mb-3 bh-captcha-field">
    <label class="form-label">@Localizer["CaptchaLbl"]</label>
    <dnt-captcha asp-captcha-generator-max="999999"
                 asp-captcha-generator-min="100000"
                 asp-captcha-generator-language="English"
                 asp-captcha-generator-display-mode="ShowDigits"
                 asp-use-relative-urls="true"
                 asp-placeholder="@Localizer["CaptchaPh"].Value"
                 asp-validation-error-message="@Localizer["CaptchaErr"].Value"
                 asp-font-name="Segoe UI"
                 asp-font-size="22"
                 asp-fore-color="#0e3a2f"
                 asp-back-color="#eef4f0"
                 asp-text-box-class="form-control"
                 asp-show-refresh-button="true"
                 asp-refresh-button-class="btn btn-sm btn-outline-secondary"
                 class="bh-captcha d-flex flex-wrap align-items-center gap-2" />
</div>
