@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Count(n => !n.IsRead);
}

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="h3 mb-0">🔔 Notifications</h1>
        @if (Model.Any())
        {
            <form asp-action="MarkAllRead" method="post" class="d-inline">
                <button type="button" id="markAllReadBtn" class="btn btn-sm btn-outline-secondary"
                        data-url="@Url.Action("MarkAllRead", "Notifications")">
                    Mark all as read
                </button>
            </form>
        }
    </div>
    <p class="text-muted">@unread unread · showing the latest @Model.Count</p>

    @if (!Model.Any())
    {
        <div class="bh-empty">
            <span class="emoji">🔔</span>
            <p class="mb-0">No notifications yet.</p>
        </div>
    }
    else
    {
        <div class="bh-form-section">
            <ul class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <li class="list-group-item @(n.IsRead ? "" : "list-group-item-success") d-flex justify-content-between align-items-start">
                        <div class="me-2">
                            <div class="fw-semibold @(n.IsRead ? "text-muted" : "")">@n.Title</div>
                            <div class="text-muted small">@n.Message</div>
                            <div class="text-muted" style="font-size: .72rem;">@n.CreatedAt.ToString("dd MMM yyyy HH:mm") · @n.Type</div>
                        </div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="mark-read-form flex-shrink-0">
                                <button type="submit" class="btn btn-sm btn-outline-success">✓ Mark read</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>
