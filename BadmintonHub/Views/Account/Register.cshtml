@model RegisterViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap">
    <div class="auth-brand-panel">
        <div class="auth-brand-inner">
            <div class="auth-logo">🏸</div>
            <h1>@Localizer["Title"]</h1>
            <p class="auth-brand-sub">@Localizer["Subtitle"]</p>
            <ul class="auth-features">
                <li>🛡️ @Localizer["FeatBook"]</li>
                <li>💳 @Localizer["FeatPay"]</li>
                <li>📱 @Localizer["FeatQr"]</li>
            </ul>
        </div>
    </div>
    <div class="auth-form-panel">
        <div class="auth-form-inner">
            <h2 class="h4 mb-1">@Localizer["Title"]</h2>
            <p class="text-muted small mb-4">@Localizer["Subtitle"]</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label for="FullName" class="form-label">@Localizer["FullNameLbl"]</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label">@Localizer["EmailLbl"]</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="Phone" class="form-label">@Localizer["PhoneLbl"]</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="Password" class="form-label">@Localizer["PasswordLbl"]</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="form-text">@Localizer["PasswordHint"]</div>
                </div>
                <div class="mb-3">
                    <label for="ConfirmPassword" class="form-label">@Localizer["ConfirmLbl"]</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <partial name="_Captcha" />

                <button type="submit" class="btn btn-bh w-100">@Localizer["RegisterBtn"]</button>
            </form>
            <p class="small mt-3 mb-0 text-center">
                @Localizer["HaveAccount"] <a asp-action="Login">@Localizer["LoginLink"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
