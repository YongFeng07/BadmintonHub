@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrap">
    <div class="auth-brand-panel">
        <div class="auth-brand-inner">
            <div class="auth-logo">🔑</div>
            <h1>Forgot Password</h1>
            <p class="auth-brand-sub">We will issue a secure single-use reset link for your account.</p>
            <ul class="auth-features">
                <li>🛡️ Links expire after 30 minutes</li>
                <li>💳 One-time use only</li>
                <li>📱 Never reveals whether an email is registered</li>
            </ul>
        </div>
    </div>
    <div class="auth-form-panel">
        <div class="auth-form-inner">
            <h2 class="h4 mb-1">Reset your password</h2>
            <p class="text-muted small mb-4">Enter your email and we will issue a password reset link.</p>

            @if (ViewBag.ResetLinkSent == true)
            {
                <div class="alert alert-info">
                    If that email address is registered, a reset link has been issued.
                    @if (ViewBag.ResetLink != null)
                    {
                        <hr class="my-2" />
                        <div class="small">
                            <strong>Demo note:</strong> no email service is configured in this assignment
                            system, so the link is shown here for demonstration:
                            <div class="mt-1 text-break"><a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a></div>
                        </div>
                    }
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <partial name="_Captcha" />

                <button type="submit" class="btn btn-bh w-100">Send Reset Link</button>
            </form>
            <p class="small mt-3 mb-0 text-center">
                <a asp-action="Login">Back to login</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
