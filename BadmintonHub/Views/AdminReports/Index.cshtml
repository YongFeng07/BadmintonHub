@model AdminReportsViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">📈 Reports &amp; Analytics</h1>
    <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label small mb-1">From</label>
            <input type="date" name="from" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label class="form-label small mb-1">To</label>
            <input type="date" name="to" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-bh btn-sm">Apply</button>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")">⬇ CSV</a>
    </form>
</div>
<p class="text-muted">Range: @Model.FromDate.ToString("dd MMM yyyy") – @Model.ToDate.ToString("dd MMM yyyy")</p>

<div class="row g-3">
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Revenue</div>
            <div class="bh-kpi-value">RM @Model.Revenue.ToString("N2")</div>
            <div class="bh-kpi-sub">paid in range</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Bookings</div>
            <div class="bh-kpi-value">@Model.BookingCount</div>
            <div class="bh-kpi-sub">all statuses</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Avg Booking Value</div>
            <div class="bh-kpi-value">RM @Model.AverageBookingValue.ToString("0.00")</div>
            <div class="bh-kpi-sub">per reservation</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Cancellations</div>
            <div class="bh-kpi-value">@Model.CancellationCount</div>
            <div class="bh-kpi-sub">in range</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Daily revenue</h2>
            <canvas id="revByDayChart" height="80"></canvas>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Court utilisation (%)</h2>
            <canvas id="utilChart" height="80"></canvas>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Popular courts (bookings)</h2>
            <canvas id="popularChart" height="80"></canvas>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Peak hours (bookings by start time)</h2>
            <canvas id="peakReportChart" height="80"></canvas>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Monthly bookings — last 12 months</h2>
            <canvas id="monthlyBookingChart" height="80"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Revenue by month — last 12 months</h2>
            <canvas id="monthlyRevenueChart" height="80"></canvas>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Bookings by category (in range)</h2>
            <canvas id="categoryChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Booking outcomes (in range)</h2>
            <canvas id="outcomeChart" height="110"></canvas>
            <p class="small text-muted mt-2 mb-0">
                Cancellation rate: <strong>@Model.CancellationRate.ToString("0.0")%</strong>
                (@Model.CancelledTotal cancelled, @Model.CompletedTotal completed, @Model.ActiveTotal active)
            </p>
        </div>
    </div>
</div>

<div class="bh-form-section mt-3">
    <h2 class="h6 text-uppercase text-muted mb-2">Paid bookings in range (top 20)</h2>
    @if (!Model.RevenueRows.Any())
    {
        <p class="text-muted mb-0">No paid bookings in this range.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle bh-table mb-0">
                <thead><tr><th>Reference</th><th>Member</th><th>Court</th><th>Date</th><th>Paid At</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.RevenueRows)
                    {
                        <tr>
                            <td>@r.ReservationReference</td>
                            <td>@r.User?.FullName</td>
                            <td>Court @(r.Court?.CourtNumber ?? "—")</td>
                            <td class="text-nowrap">@r.ReservationDate.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap">@(r.Payment?.PaidAt?.ToString("dd MMM HH:mm") ?? "—")</td>
                            <td class="text-end fw-semibold">RM @r.TotalAmount.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        $(function () {
            var green = '#0b3d2e', amber = '#f0a500', red = '#a94442';

            new Chart($('#revByDayChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RevenueByDayLabels)),
                    datasets: [{ label: 'Revenue (RM)', data: @Html.Raw(Json.Serialize(Model.RevenueByDayData)), backgroundColor: green }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            new Chart($('#utilChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.UtilizationCourtLabels)),
                    datasets: [{ label: 'Utilisation %', data: @Html.Raw(Json.Serialize(Model.UtilizationCourtData)), backgroundColor: amber }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, max: 100 } } }
            });

            new Chart($('#popularChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.PopularCourtLabels)),
                    datasets: [{ label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.PopularCourtData)), backgroundColor: green }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            new Chart($('#peakReportChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.PeakHourLabels)),
                    datasets: [{ label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.PeakHourData)), borderColor: red, backgroundColor: 'rgba(169,68,66,.12)', fill: true, tension: .3 }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            var palette = ['#0b3d2e', '#17714f', '#2b9e74', '#f0a500', '#2b6cb0', '#7b4bb7', '#a94442', '#6b7a72'];

            new Chart($('#monthlyBookingChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.MonthlyBookingLabels)),
                    datasets: [{ label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.MonthlyBookingData)), backgroundColor: green }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            new Chart($('#monthlyRevenueChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.MonthlyRevenueLabels)),
                    datasets: [{ label: 'Revenue (RM)', data: @Html.Raw(Json.Serialize(Model.MonthlyRevenueData)), backgroundColor: amber }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            new Chart($('#categoryChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.CategoryLabels)),
                    datasets: [{ data: @Html.Raw(Json.Serialize(Model.CategoryData)), backgroundColor: palette }]
                },
                options: { plugins: { legend: { position: 'bottom' } } }
            });

            new Chart($('#outcomeChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Cancelled', 'Completed', 'Active'],
                    datasets: [{
                        data: [@Model.CancelledTotal, @Model.CompletedTotal, @Model.ActiveTotal],
                        backgroundColor: [red, '#2b6cb0', green]
                    }]
                },
                options: { plugins: { legend: { position: 'bottom' } } }
            });
        });
    </script>
}
