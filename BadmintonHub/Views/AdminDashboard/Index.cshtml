@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">📊 Dashboard</h1>
    <span class="text-muted">Live data · @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
</div>

<div class="row g-3 mt-1">
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Total Revenue</div>
            <div class="bh-kpi-value">RM @Model.TotalRevenue.ToString("N2")</div>
            <div class="bh-kpi-sub">all paid bookings</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Today's Reservations</div>
            <div class="bh-kpi-value">@Model.TodayReservations</div>
            <div class="bh-kpi-sub">pending + confirmed</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Upcoming</div>
            <div class="bh-kpi-value">@Model.UpcomingReservations</div>
            <div class="bh-kpi-sub">from today onward</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bh-kpi">
            <div class="bh-kpi-label">Today's Utilisation</div>
            <div class="bh-kpi-value">@Model.TodayUtilizationPercent%</div>
            <div class="bh-kpi-sub">booked / open slots</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Revenue — last 7 days</h2>
            <canvas id="revenueChart" height="90"></canvas>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Bookings per court (30 days)</h2>
            <canvas id="courtChart" height="90"></canvas>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Peak hours (30 days)</h2>
            <canvas id="peakChart" height="90"></canvas>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Recent reservations</h2>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle bh-table mb-0">
                    <thead><tr><th>Reference</th><th>Member</th><th>Court</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.RecentReservations)
                        {
                            <tr>
                                <td>@r.ReservationReference</td>
                                <td>@r.User?.FullName</td>
                                <td>@(r.Court?.CourtNumber ?? "—")</td>
                                <td class="text-nowrap">@r.ReservationDate.ToString("dd MMM") @r.StartTime.ToString("HH:mm")</td>
                                <td><span class="badge badge-status badge-@r.Status.ToString().ToLowerInvariant()">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-end">
                <a asp-controller="AdminReservations" asp-action="Index" class="small">Manage reservations →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        $(function () {
            var green = '#0b3d2e', amber = '#f0a500', muted = '#6c757d';

            new Chart($('#revenueChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RevenueLabels)),
                    datasets: [{
                        label: 'Revenue (RM)', data: @Html.Raw(Json.Serialize(Model.RevenueData)),
                        borderColor: green, backgroundColor: 'rgba(11,61,46,.15)', fill: true, tension: .3
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            new Chart($('#courtChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.CourtLabels)),
                    datasets: [{
                        label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.CourtData)),
                        backgroundColor: green
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            new Chart($('#peakChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.PeakHourLabels)),
                    datasets: [{
                        label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.PeakHourData)),
                        backgroundColor: amber
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
        });
    </script>
}
