@model Reservation
@{
    ViewData["Title"] = "Reservation " + Model.ReservationReference;
    var canCancel = ViewBag.CanCancel == true;
    var canPay = ViewBag.CanPay == true;
    var isPrivileged = ViewBag.IsPrivileged == true;
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="MyReservations">My Reservations</a></li>
        <li class="breadcrumb-item active">@Model.ReservationReference</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bh-form-section">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <h1 class="h3 mb-0">@Model.ReservationReference</h1>
                <span class="badge badge-status badge-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
            </div>
            <hr />

            <h2 class="h6 text-uppercase text-muted mb-3">Reservation timeline</h2>
            <div class="bh-timeline mb-4">
                <span class="bh-timeline-step done">Created</span>
                <span class="bh-timeline-arrow">→</span>
                @if (Model.Status == ReservationStatus.Cancelled || Model.Status == ReservationStatus.Rejected)
                {
                    <span class="bh-timeline-step cancelled">@Model.Status</span>
                }
                else
                {
                    var paid = Model.Payment?.Status == PaymentStatus.Paid || Model.Payment?.Status == PaymentStatus.Refunded;
                    <span class="bh-timeline-step @(paid ? "done" : "")">Paid</span>
                    <span class="bh-timeline-arrow">→</span>
                    <span class="bh-timeline-step @(Model.Status == ReservationStatus.Confirmed || Model.Status == ReservationStatus.Completed ? "done" : "")">Confirmed</span>
                    <span class="bh-timeline-arrow">→</span>
                    <span class="bh-timeline-step @(Model.Status == ReservationStatus.Completed ? "done" : "")">Completed</span>
                }
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Booking details</h2>
            <dl class="row">
                <dt class="col-sm-4">Court</dt>
                <dd class="col-sm-8">Court @Model.Court?.CourtNumber <span class="text-muted">(@Model.Court?.CourtType)</span></dd>
                <dt class="col-sm-4">Facility</dt>
                <dd class="col-sm-8">@(Model.Court?.Facility?.Name ?? "—")</dd>
                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.ReservationDate.ToString("dd MMMM yyyy")</dd>
                <dt class="col-sm-4">Time</dt>
                <dd class="col-sm-8">@Model.StartTime.ToString("HH:mm") – @Model.EndTime.ToString("HH:mm") (@Model.DurationHours.ToString("0.#") h)</dd>
                <dt class="col-sm-4">Total Amount</dt>
                <dd class="col-sm-8 fw-bold text-bh-green">RM @Model.TotalAmount.ToString("0.00")</dd>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@Model.Notes</dd>
                }
            </dl>

            <h2 class="h6 text-uppercase text-muted mb-3 mt-4">Payment</h2>
            @if (Model.Payment != null)
            {
                <dl class="row">
                    <dt class="col-sm-4">Method</dt>
                    <dd class="col-sm-8">@Model.Payment.Method</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge badge-status badge-@Model.Payment.Status.ToString().ToLowerInvariant()">@Model.Payment.Status</span></dd>
                    <dt class="col-sm-4">Reference</dt>
                    <dd class="col-sm-8">@(Model.Payment.PaymentReference ?? "—")</dd>
                    @if (Model.Payment.PaidAt.HasValue)
                    {
                        <dt class="col-sm-4">Paid At</dt>
                        <dd class="col-sm-8">@Model.Payment.PaidAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                </dl>
            }
            else
            {
                <p class="text-muted">No payment record.</p>
            }

            @if (Model.Status == ReservationStatus.Cancelled)
            {
                <h2 class="h6 text-uppercase text-muted mb-2 mt-4">Cancellation</h2>
                <p class="text-muted">
                    @(Model.CancellationReason ?? "No reason provided.")
                    @if (Model.CancelledAt.HasValue)
                    {
                        <span class="small">(cancelled @Model.CancelledAt.Value.ToString("dd MMM yyyy HH:mm"))</span>
                    }
                </p>
            }

            @if (canPay || canCancel)
            {
                <div class="d-flex gap-2 mt-4 flex-wrap">
                    @if (canPay)
                    {
                        <a asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-bh-amber">💳 Complete Payment</a>
                    }
                    @if (canCancel)
                    {
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#cancelForm">Cancel Reservation</button>
                    }
                </div>
                @if (canCancel)
                {
                    <div class="collapse mt-3" id="cancelForm">
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="border border-danger rounded p-3 bg-light">
                            <p class="small text-muted">Cancelling is final. A paid booking will be refunded.</p>
                            <div class="mb-2">
                                <label for="cancelReason" class="form-label small">Reason (optional)</label>
                                <textarea name="reason" id="cancelReason" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm">Confirm Cancellation</button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>

    <div class="col-lg-4">
        @if (ViewBag.QrDataUri != null)
        {
            <div class="bh-form-section">
                <h2 class="h6 text-uppercase text-muted mb-2">Booking confirmation (QR)</h2>
                <div class="bh-qr-panel">
                    <img src="@ViewBag.QrDataUri" alt="QR confirmation for @Model.ReservationReference" />
                    <p class="small text-muted mt-2 mb-0">
                        Scan to verify this booking. The QR only contains the public reservation
                        reference — no personal or payment data.
                    </p>
                </div>
            </div>
        }
        <div class="bh-form-section">
            <h2 class="h6 text-uppercase text-muted mb-2">Member</h2>
            @if (isPrivileged)
            {
                <p class="mb-1">@Model.User?.FullName</p>
                <p class="small text-muted mb-0">@Model.User?.Email</p>
            }
            else
            {
                <p class="text-muted small mb-0">Member details are visible only to the booking owner and staff.</p>
            }
        </div>
    </div>
</div>
