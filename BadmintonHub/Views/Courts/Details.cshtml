@model BadmintonHub.Models.Court
@{
    ViewData["Title"] = "Court " + Model.CourtNumber;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var photos = Model.Photos.OrderBy(p => p.DisplayOrder).ToList();
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Courts" asp-action="Index">Courts</a></li>
        <li class="breadcrumb-item active">Court @Model.CourtNumber</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-7">
        @if (photos.Count > 0)
        {
            <div id="courtCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner" style="border-radius: 12px; overflow: hidden; max-height: 420px;">
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@photos[i].FilePath" class="d-block w-100" style="height: 420px; object-fit: cover;" alt="@(photos[i].Caption ?? "Court photo")" />
                            @if (!string.IsNullOrEmpty(photos[i].Caption))
                            {
                                <div class="carousel-caption d-none d-md-block" style="background: rgba(11,61,46,.65); border-radius: 8px;">
                                    <p class="mb-0">@photos[i].Caption</p>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (photos.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#courtCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#courtCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="bh-empty"><span class="emoji">🏸</span>No photos yet.</div>
        }

        <div class="bh-form-section mt-3">
            <h4 class="mb-3">About this court</h4>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="bh-form-section">
            <div class="d-flex justify-content-between align-items-start">
                <h4 class="mb-0">Court @Model.CourtNumber</h4>
                @switch (Model.Status)
                {
                    case CourtStatus.Available:
                        <span class="badge badge-status badge-open">Available</span>
                        break;
                    case CourtStatus.Maintenance:
                        <span class="badge badge-status badge-maintenance">Maintenance</span>
                        break;
                    default:
                        <span class="badge badge-status badge-unavailable">Unavailable</span>
                        break;
                }
            </div>
            <hr />
            <dl class="row mb-0">
                <dt class="col-5">Court Type</dt>
                <dd class="col-7">@Model.CourtType</dd>
                <dt class="col-5">Hourly Rate</dt>
                <dd class="col-7 fw-bold text-bh-green">RM @Model.HourlyRate.ToString("0.00")</dd>
                <dt class="col-5">Facility</dt>
                <dd class="col-7">@(Model.Facility?.Name ?? "—")</dd>
            </dl>
        </div>

        <div class="bh-form-section">
            <h5 class="mb-3">Check Availability</h5>
            <div class="mb-3">
                <label for="availabilityDate" class="form-label">Date</label>
                <input type="date" id="availabilityDate" class="form-control" min="@today.ToString("yyyy-MM-dd")" value="@today.ToString("yyyy-MM-dd")" />
            </div>
            <div id="availabilityResult" class="text-muted small">Select a date to see slot availability.</div>

            <hr />
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Reservations" asp-action="Create" asp-route-courtId="@Model.Id"
                   asp-route-date="@today.ToString("yyyy-MM-dd")" class="btn btn-bh w-100">Book This Court</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-bh w-100">Login to Book This Court</a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function loadAvailability() {
                var date = $('#availabilityDate').val();
                if (!date) return;
                var $result = $('#availabilityResult');
                $result.html('<div class="spinner-border spinner-border-sm text-success me-2"></div>Loading availability…');
                $.getJSON('@Url.Action("CheckAvailability", "Courts")', { courtId: @Model.Id, date: date })
                    .done(function (res) {
                        if (!res.success) { $result.html('<div class="alert alert-danger py-2">' + res.message + '</div>'); return; }
                        var html = '<table class="table table-sm table-bordered align-middle mb-0">' +
                                   '<thead><tr><th>Time</th><th>Status</th></tr></thead><tbody>';
                        res.slots.forEach(function (s) {
                            html += '<tr><td class="text-nowrap">' + s.startTime + ' – ' + s.endTime + '</td>' +
                                    '<td><span class="badge badge-status badge-' + s.status + '">' + s.label + '</span></td></tr>';
                        });
                        html += '</tbody></table>';
                        html += '<div class="mt-2 small text-muted">Legend: Open = bookable · Booked = taken · Maintenance/Blocked = unavailable</div>';
                        $result.html(html);
                    })
                    .fail(function () {
                        $result.html('<div class="alert alert-danger py-2">Could not load availability. Please try again.</div>');
                    });
            }
            $('#availabilityDate').on('change', loadAvailability);
            loadAvailability();
        });
    </script>
}
