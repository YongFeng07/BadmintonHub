@model AdminUserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "_AdminLayout";
    var user = Model.User;
    var initials = string.Concat(user.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => char.ToUpperInvariant(w[0]))
        .Take(2));
    var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.Now;
}

<div class="bh-admin-topbar">
    <h1 class="h3 mb-0">👁 User Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-bh btn-sm">✏️ Edit Profile</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="bh-form-section text-center">
            @if (user.PhotoUrl != null)
            {
                <img src="@user.PhotoUrl" alt="Profile photo" class="bh-avatar-lg mb-3" />
            }
            else
            {
                <span class="bh-avatar-lg bh-avatar-initials mb-3">@initials</span>
            }
            <h2 class="h5 mb-1">@user.FullName</h2>
            <div class="text-muted">@user.Email</div>
            @if (user.Phone != null)
            {
                <div class="text-muted small">📞 @user.Phone</div>
            }
            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                <span class="badge @(user.Role == Role.SuperAdmin ? "bg-danger" : user.Role == Role.Admin ? "bg-warning text-dark" : "bg-secondary")">@user.Role</span>
                @if (user.Status == UserStatus.Active)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-dark">@user.Status</span>
                }
                @if (user.EmailVerified)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">✉️ Email verified</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">✉️ Unverified</span>
                }
                @if (isLocked)
                {
                    <span class="badge bg-danger">🔒 Locked until @user.LockoutEnd?.ToString("dd MMM HH:mm")</span>
                }
            </div>
            @if (isLocked)
            {
                <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="mt-3">
                    <button type="submit" class="btn btn-outline-success btn-sm">🔓 Unlock Account</button>
                </form>
            }
        </div>
    </div>
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h2 class="h6 mb-3">Activity</h2>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="border rounded-3 p-3 text-center">
                        <div class="fs-3 fw-bold text-bh-green">@Model.ReservationCount</div>
                        <div class="small text-muted">Reservations</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded-3 p-3 text-center">
                        <div class="fs-3 fw-bold text-bh-green">@Model.ConfirmedCount</div>
                        <div class="small text-muted">Confirmed</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded-3 p-3 text-center">
                        <div class="fs-3 fw-bold text-bh-green">@Model.CancelledCount</div>
                        <div class="small text-muted">Cancelled</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded-3 p-3 text-center">
                        <div class="fs-3 fw-bold text-bh-green">RM @Model.TotalPaid.ToString("0.00")</div>
                        <div class="small text-muted">Total Paid</div>
                    </div>
                </div>
            </div>

            <h2 class="h6 mt-4 mb-3">Account</h2>
            <table class="table table-sm mb-0">
                <tr><th class="text-muted fw-normal">Registered</th><td>@user.CreatedAt.ToString("dd MMM yyyy HH:mm")</td></tr>
                <tr><th class="text-muted fw-normal">Last updated</th><td>@(user.UpdatedAt?.ToString("dd MMM yyyy HH:mm") ?? "never")</td></tr>
                <tr><th class="text-muted fw-normal">Last login</th><td>@(user.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "never")</td></tr>
                <tr><th class="text-muted fw-normal">Failed logins</th><td>@user.FailedLoginAttempts / 3</td></tr>
            </table>
        </div>
    </div>
</div>
