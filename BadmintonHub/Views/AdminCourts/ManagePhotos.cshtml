@model BadmintonHub.Models.Court
@{
    ViewData["Title"] = "Court Photos";
    Layout = "_AdminLayout";
    var photos = Model.Photos.OrderBy(p => p.DisplayOrder).ToList();
}

<div class="bh-admin-topbar">
    <div>
        <h2 class="bh-page-title mb-0">Photos — Court @Model.CourtNumber</h2>
        <p class="bh-page-sub mb-0">@photos.Count photo(s). The first photo is shown as the cover image.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Courts</a>
</div>

<div class="bh-form-section">
    <h5 class="mb-3">Upload New Photos</h5>
    <form asp-action="UploadPhotos" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="courtId" value="@Model.Id" />
        <div class="mb-3">
            <input type="file" name="photos" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple required />
            <div class="form-text">JPG, PNG, WebP or GIF — up to 2 MB each. You can select several files at once.</div>
        </div>
        <button type="submit" class="btn btn-bh">Upload</button>
    </form>
</div>

@if (photos.Count == 0)
{
    <div class="bh-empty"><span class="emoji">🖼️</span>No photos yet — upload the first one above.</div>
}
else
{
    <div class="row g-3">
        @foreach (var photo in photos)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card bh-card h-100">
                    <img src="@photo.FilePath" class="card-img-top" style="height: 140px;" alt="@photo.Caption" />
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (photo.IsPrimary)
                                {
                                    <span class="badge badge-status badge-open">Cover</span>
                                }
                                <span class="small text-muted">#@photo.DisplayOrder</span>
                            </div>
                            <form asp-action="DeletePhoto" method="post" onsubmit="return confirm('Remove this photo?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="photoId" value="@photo.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                            </form>
                        </div>
                        <div class="small text-muted text-truncate mt-1" title="@photo.Caption">@photo.Caption</div>
                    </div>
                </div>
            </div>
        }
    </div>
}
