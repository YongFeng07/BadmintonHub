@model BadmintonHub.ViewModels.AdminCourtIndexViewModel
@{
    ViewData["Title"] = "Court Management";
    Layout = "_AdminLayout";
}

<div class="bh-admin-topbar">
    <div>
        <h2 class="bh-page-title mb-0">Court Management</h2>
        <p class="bh-page-sub mb-0">@Model.TotalCount court(s) in total.</p>
    </div>
    <a asp-action="Create" class="btn btn-bh">+ Add Court</a>
</div>

<form method="get" asp-action="Index" class="bh-form-section d-flex flex-wrap gap-2 align-items-center">
    <div class="flex-grow-1" style="min-width: 180px;">
        <input type="text" name="search" class="form-control" placeholder="Search court number…" value="@Model.Search" />
    </div>
    <div>
        <select name="type" class="form-select">
            <option value="">All Types</option>
            @foreach (var t in Enum.GetValues<BadmintonHub.Models.CourtType>())
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div>
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<BadmintonHub.Models.CourtStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-bh">Filter</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
</form>

<div class="table-responsive bh-table">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Court</th>
                <th>Type</th>
                <th>Hourly Rate</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var court in Model.Courts)
            {
                <tr>
                    <td>
                        <strong>Court @court.CourtNumber</strong>
                        <div class="small text-muted">@court.Facility?.Name</div>
                    </td>
                    <td><span class="badge badge-status" style="background:#eef3f8;color:#3c5670;">@court.CourtType</span></td>
                    <td>RM @court.HourlyRate.ToString("0.00")</td>
                    <td>
                        @if (court.Status == BadmintonHub.Models.CourtStatus.Available)
                        {
                            <span class="badge badge-status badge-open">Available</span>
                        }
                        else if (court.Status == BadmintonHub.Models.CourtStatus.Maintenance)
                        {
                            <span class="badge badge-status badge-maintenance">Maintenance</span>
                        }
                        else
                        {
                            <span class="badge badge-status badge-unavailable">Unavailable</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@court.Id" class="btn btn-sm btn-outline-success">View</a>
                        <a asp-action="Edit" asp-route-id="@court.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="ManagePhotos" asp-route-id="@court.Id" class="btn btn-sm btn-outline-info">Photos</a>
                        <a asp-action="Delete" asp-route-id="@court.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination bh-pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">← Prev</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next →</a>
            </li>
        </ul>
    </nav>
}
