@model CartIndexViewModel
@{
    ViewData["Title"] = "My Cart";
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">🛒 My Cart</h1>
            <p class="text-muted mb-0">Slots you picked — checkout converts them into bookings.</p>
        </div>
        <a asp-controller="Courts" asp-action="Index" class="btn btn-outline-secondary btn-sm">+ Browse More Courts</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="sh-form-section">
            <div class="sh-empty">
                <span class="emoji">🛒</span>
                Your cart is empty. Pick an open slot on the booking page and choose “Add to Cart”.
            </div>
            <div class="text-center">
                <a asp-controller="Reservations" asp-action="Create" class="btn btn-sh">Book a Court</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive sh-table">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 44px;">
                            <input type="checkbox" id="selectAll" form="cartForm" checked
                                   title="Select all" aria-label="Select all" />
                        </th>
                        <th>Court</th>
                        <th>Date &amp; Time</th>
                        <th style="width: 140px;">Duration</th>
                        <th class="text-end">Price</th>
                        <th class="text-end" style="width: 110px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="itemIds" value="@item.Id" form="cartForm" checked
                                       aria-label="Select item" />
                            </td>
                            <td>
                                <strong>Court @item.Court?.CourtNumber</strong>
                                <div class="small text-muted">@item.Court?.Facility?.Name · @item.Court?.CourtType</div>
                            </td>
                            <td>
                                <div>@item.Date.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">
                                    @item.StartTime.ToString("HH:mm") – @item.StartTime.AddHours(item.DurationHours).ToString("HH:mm")
                                </div>
                            </td>
                            <td>
                                <form asp-action="Update" method="post" class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <select name="durationHours" class="form-select form-select-sm"
                                            onchange="this.form.submit()" aria-label="Duration">
                                        @for (var h = 1; h <= 4; h++)
                                        {
                                            <option value="@h" selected="@(item.DurationHours == h ? "selected" : null)">@h hour(s)</option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td class="text-end fw-bold text-sh-green">
                                RM @((item.Court!.HourlyRate * item.DurationHours).ToString("0.00"))
                            </td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post" class="d-inline">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">✕ Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Subtotal</td>
                        <td class="text-end fw-bold text-sh-green">RM @Model.Subtotal.ToString("0.00")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <form id="cartForm" asp-action="Checkout" method="post" class="sh-form-section mt-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small mb-1" for="voucherCode">Discount voucher (optional)</label>
                    <input name="voucherCode" id="voucherCode" class="form-control text-uppercase"
                           placeholder="e.g. WELCOME10" autocomplete="off"
                           aria-describedby="voucherHelp voucherPreview" />
                    <div id="voucherPreview" class="form-text mt-2" aria-live="polite"></div>
                    <div id="voucherHelp" class="form-text">Applied and validated at checkout — try WELCOME10 (demo).</div>
                </div>
                <div class="col-md-7 d-flex gap-2 justify-content-md-end flex-wrap">
                    <button type="submit" class="btn btn-outline-danger"
                            formaction="@Url.Action("BatchRemove")">Remove Selected</button>
                    <button type="submit" class="btn btn-outline-secondary"
                            formaction="@Url.Action("Clear")">Empty Cart</button>
                    <button type="submit" class="btn btn-sh px-4">Proceed to Checkout →</button>
                </div>
            </div>
            <div class="small text-muted mt-2">
                ℹ️ Every item is re-checked for availability at checkout; double-booked or closed slots are rejected safely.
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            $('#selectAll').on('change', function () {
                $('input[name="itemIds"][form="cartForm"]').prop('checked', this.checked);
                refreshVoucherPreview();
            });

            // Live voucher preview (G-M2): debounced AJAX validation of the typed code
            // against the currently checked cart lines. Read-only — the real usage
            // count is only bumped inside the checkout transaction.
            var previewTimer = null;
            function fmt(amount) { return 'RM ' + Number(amount).toFixed(2); }

            function refreshVoucherPreview() {
                var code = $.trim($('#voucherCode').val());
                var box = $('#voucherPreview');
                if (code === '') { box.removeClass('voucher-ok voucher-bad').text(''); return; }

                var itemIds = $('input[name="itemIds"][form="cartForm"]:checked')
                    .map(function () { return $(this).val(); }).get();
                var token = $('#cartForm input[name="__RequestVerificationToken"]').val();
                box.removeClass('voucher-ok voucher-bad').text('Checking…');

                $.post('@Url.Action("VoucherPreview")', {
                    itemIds: itemIds,
                    voucherCode: code,
                    __RequestVerificationToken: token
                })
                .done(function (data) {
                    if (data.success) {
                        var text = '✓ ' + code.toUpperCase() + ' saves ' + fmt(data.discount)
                            + ' — you pay ' + fmt(data.netTotal);
                        if (data.warning) text += ' ' + data.warning;
                        box.addClass('voucher-ok').removeClass('voucher-bad').text(text);
                    } else {
                        box.addClass('voucher-bad').removeClass('voucher-ok').text('✕ ' + data.error);
                    }
                })
                .fail(function () {
                    box.addClass('voucher-bad').removeClass('voucher-ok')
                        .text('✕ Could not check the voucher — please retry.');
                });
            }

            $('#voucherCode').on('input', function () {
                clearTimeout(previewTimer);
                previewTimer = setTimeout(refreshVoucherPreview, 400);
            });
            $('input[name="itemIds"][form="cartForm"]').on('change', refreshVoucherPreview);
        });
    </script>
}
