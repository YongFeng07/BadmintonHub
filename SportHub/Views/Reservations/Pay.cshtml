@model ReservationPaymentViewModel
@{
    ViewData["Title"] = "Payment — " + Model.Reservation?.ReservationReference;
    var r = Model.Reservation;
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<div class="mt-3">
    <h1 class="h3 mb-1">💳 Complete Payment</h1>
    <p class="text-muted">Confirm payment for your booking to secure the court.</p>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="bh-form-section">
                <h2 class="h6 text-uppercase text-muted mb-3">Booking summary</h2>
                @if (r != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-5">Reference</dt><dd class="col-7">@r.ReservationReference</dd>
                        <dt class="col-5">Court</dt><dd class="col-7">Court @r.Court?.CourtNumber</dd>
                        <dt class="col-5">Date</dt><dd class="col-7">@r.ReservationDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-5">Time</dt><dd class="col-7">@r.StartTime.ToString("HH:mm") – @r.EndTime.ToString("HH:mm")</dd>
                        <dt class="col-5 fw-bold">Total Due</dt><dd class="col-7 fw-bold text-bh-green">RM @r.TotalAmount.ToString("0.00")</dd>
                    </dl>
                }
            </div>
            <p class="small text-muted mt-2">
                ⚠️ Demo payment simulation — no real money changes hands. Selecting a method and
                confirming records the payment and confirms the booking.
            </p>
        </div>

        <div class="col-lg-7">
            <div class="bh-form-section">
                <form asp-action="Pay" method="post">
                    <input type="hidden" asp-for="ReservationId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <h2 class="h6 text-uppercase text-muted mb-2">Payment method</h2>
                    <div class="mb-3">
                        @foreach (var method in Enum.GetValues<PaymentMethod>())
                        {
                            var id = "method_" + method;
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Method" value="@method" id="@id"
                                       checked="@(Model.Method == method ? "checked" : null)" />
                                <label class="form-check-label" for="@id">
                                    @switch (method)
                                    {
                                        case PaymentMethod.OnlineTransfer: <span>🏦 Online Transfer</span>; break;
                                        case PaymentMethod.Card: <span>💳 Card</span>; break;
                                        default: <span>💵 Cash (at counter)</span>; break;
                                    }
                                </label>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentReference" class="form-label">Payment Reference (optional)</label>
                        <input asp-for="PaymentReference" class="form-control" placeholder="e.g. your bank transaction ID" />
                        <span asp-validation-for="PaymentReference" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-bh">Confirm Payment — RM @(r?.TotalAmount.ToString("0.00") ?? "0.00")</button>
                    <a asp-action="Details" asp-route-id="@Model.ReservationId" class="btn btn-outline-secondary ms-1">Back to Reservation</a>
                </form>
            </div>
        </div>
    </div>
</div>
