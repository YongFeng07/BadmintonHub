@* G-M6 member reservation list region. Model: MyReservationListViewModel (tab + paged list). *@
@model SportHub.ViewModels.MyReservationListViewModel
@{
    var pager = Model.Page.Pager;
}

@if (Model.Page.Items.Count == 0)
{
    <div class="sh-empty">
        <span class="emoji">🏸</span>
        @if (!string.IsNullOrEmpty(pager.Search))
        {
            <p class="mb-0">No reservations match "@pager.Search".</p>
        }
        else
        {
            @switch (Model.Tab)
            {
                case "completed":
                    <p class="mb-0">No completed reservations yet.</p>
                    break;
                case "cancelled":
                    <p class="mb-0">No cancelled reservations.</p>
                    break;
                default:
                    <p class="mb-0">No upcoming reservations. <a asp-action="Create">Book your first court!</a></p>
                    break;
            }
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle sh-table">
            <thead>
                <tr>
                    <th>
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("reference")"
                           aria-sort="@pager.AriaSortFor("reference")">Reference <span class="sh-sort-arrow">@pager.ArrowFor("reference")</span></a>
                    </th>
                    <th>
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("court")"
                           aria-sort="@pager.AriaSortFor("court")">Court <span class="sh-sort-arrow">@pager.ArrowFor("court")</span></a>
                    </th>
                    <th>
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("date")"
                           aria-sort="@pager.AriaSortFor("date")">Date <span class="sh-sort-arrow">@pager.ArrowFor("date")</span></a>
                    </th>
                    <th>Time</th>
                    <th>Hours</th>
                    <th>
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("status")"
                           aria-sort="@pager.AriaSortFor("status")">Status <span class="sh-sort-arrow">@pager.ArrowFor("status")</span></a>
                    </th>
                    <th class="text-end">
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("amount")"
                           aria-sort="@pager.AriaSortFor("amount")">Amount <span class="sh-sort-arrow">@pager.ArrowFor("amount")</span></a>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Page.Items)
                {
                    <tr>
                        <td class="fw-semibold">@r.ReservationReference</td>
                        <td>@(r.Court?.CourtNumber ?? "—")</td>
                        <td>@r.ReservationDate.ToString("dd MMM yyyy")</td>
                        <td class="text-nowrap">@r.StartTime.ToString("HH:mm") – @r.EndTime.ToString("HH:mm")</td>
                        <td>@r.DurationHours.ToString("0.#") h</td>
                        <td>
                            <span class="badge badge-status badge-@r.Status.ToString().ToLowerInvariant()">@r.Status</span>
                            @if (r.Payment != null)
                            {
                                <span class="badge badge-status badge-@r.Payment.Status.ToString().ToLowerInvariant()">@r.Payment.Status</span>
                            }
                        </td>
                        <td class="text-end">RM @r.TotalAmount.ToString("0.00")</td>
                        <td class="text-end text-nowrap">
                            @if (r.Payment?.Status == PaymentStatus.Paid || r.Payment?.Status == PaymentStatus.Refunded)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Receipt" asp-route-id="@r.Id"
                                   title="Download PDF e-receipt" aria-label="Download PDF e-receipt">⬇ PDF</a>
                            }
                            <a class="btn btn-sm btn-outline-success" asp-action="Details" asp-route-id="@r.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_AjaxPager" model="pager" />
