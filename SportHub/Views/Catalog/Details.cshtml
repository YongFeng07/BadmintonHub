@model SportHub.Models.Facility
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Model.Name;
    var photos = Model.Photos.OrderBy(p => p.DisplayOrder).ToList();
    var cover = photos.FirstOrDefault(p => p.IsPrimary) ?? photos.FirstOrDefault();
}

<a asp-action="Index" class="btn btn-outline-success btn-sm mt-3 mb-2">← @Localizer["BackToCatalog"]</a>

<div class="bh-hero mt-2">
    <h1 class="display-5 mb-2">@Model.Category?.Icon @Model.Name</h1>
    <p class="lead mb-3">@Model.Description</p>
    <span class="badge badge-status badge-open me-2">@Model.Category?.Name</span>
    @if (Model.Status == FacilityStatus.Open)
    {
        <span class="badge badge-status badge-open">@Localizer["Open"]</span>
    }
    else
    {
        <span class="badge badge-status badge-closed">@Localizer["Closed"]</span>
    }
</div>

@if (photos.Count > 0)
{
    <div class="row g-3 mb-2">
        <div class="col-lg-8">
            <img src="@cover!.FilePath" class="img-fluid w-100 rounded-3" style="height: 340px; object-fit: cover;" alt="@Model.Name" />
        </div>
        <div class="col-lg-4 d-flex flex-column gap-3">
            @foreach (var photo in photos.Where(p => p != cover).Take(2))
            {
                <img src="@photo.FilePath" class="img-fluid w-100 rounded-3" style="height: 162px; object-fit: cover;" alt="@photo.Caption" />
            }
        </div>
    </div>
}

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="bh-form-section">
            <h4 class="mb-3">🏟️ @Localizer["OurUnits", Model.Category?.UnitLabel ?? "Units"]</h4>
            @if (Model.Courts.Count == 0)
            {
                <p class="text-muted mb-0">@Localizer["NoUnits"]</p>
            }
            else
            {
                <div class="table-responsive bh-table">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>@Model.Category?.UnitLabel</th>
                                <th>@Localizer["Type"]</th>
                                <th>@Localizer["Rate"]</th>
                                <th class="text-end">@Localizer["Action"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var court in Model.Courts)
                            {
                                <tr>
                                    <td><strong>@court.CourtNumber</strong></td>
                                    <td>@court.CourtType</td>
                                    <td>RM @court.HourlyRate.ToString("0.00")<span class="text-muted small">/@Localizer["Hour"]</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Courts" asp-action="Details" asp-route-id="@court.Id"
                                           class="btn btn-bh btn-sm">@Localizer["ViewBook"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="bh-form-section">
            <h4 class="mb-3">📋 @Localizer["Rules"]</h4>
            @if (string.IsNullOrWhiteSpace(Model.Rules))
            {
                <p class="text-muted mb-0">@Localizer["NoRules"]</p>
            }
            else
            {
                <div style="white-space: pre-line;" class="text-muted mb-0">@Model.Rules</div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="bh-form-section">
            <h4 class="mb-3">🕗 @Localizer["OpeningInfo"]</h4>
            <dl class="row mb-0">
                <dt class="col-5">@Localizer["Hours"]</dt>
                <dd class="col-7">@Model.OpeningTime.ToString(@"hh\:mm") – @Model.ClosingTime.ToString(@"hh\:mm")</dd>
                <dt class="col-5">@Localizer["Days"]</dt>
                <dd class="col-7">@Model.OperatingDays</dd>
                <dt class="col-5">@Localizer["Status"]</dt>
                <dd class="col-7">
                    @if (Model.Status == FacilityStatus.Open)
                    {
                        <span class="badge badge-status badge-open">@Localizer["Open"]</span>
                    }
                    else
                    {
                        <span class="badge badge-status badge-closed">@Localizer["Closed"]</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="bh-form-section">
            <h4 class="mb-3">📞 @Localizer["Contact"]</h4>
            <dl class="row mb-0">
                <dt class="col-5">@Localizer["Address"]</dt>
                <dd class="col-7">@Model.Address</dd>
                <dt class="col-5">@Localizer["Phone"]</dt>
                <dd class="col-7">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd>
                <dt class="col-5">@Localizer["Email"]</dt>
                <dd class="col-7">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd>
            </dl>
        </div>
    </div>
</div>
