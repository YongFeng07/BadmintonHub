@model AdminUsersIndexViewModel
@{
    ViewData["Title"] = "User Accounts";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">👥 User Accounts</h1>
    @if (Model.LockedCount > 0)
    {
        <span class="badge bg-danger">@Model.LockedCount locked account(s)</span>
    }
</div>

<div class="sh-form-section mt-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Name or email" />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Role</label>
            <select name="role" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var r in Enum.GetValues<Role>())
                {
                    <option value="@r" selected="@(Model.RoleFilter == r.ToString() ? "selected" : null)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<UserStatus>())
                {
                    <option value="@s" selected="@(Model.StatusFilter == s.ToString() ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-sh btn-sm">Filter</button>
        </div>
    </form>
</div>

<div class="table-responsive sh-form-section mt-3">
    <table class="table table-hover align-middle sh-table mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Failed Logins</th>
                <th>Last Login</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.Now;
                <tr class="@(isLocked ? "table-danger" : "")">
                    <td class="pe-1">
                        @if (user.PhotoUrl != null)
                        {
                            <img src="@user.PhotoUrl" alt="" class="sh-avatar-md" />
                        }
                        else
                        {
                            var initials = string.Concat(user.FullName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Select(w => char.ToUpperInvariant(w[0]))
                                .Take(2));
                            <span class="sh-avatar-md sh-avatar-initials">@initials</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@user.Id" class="fw-semibold text-decoration-none text-sh-green">@user.FullName</a>
                        @if (!user.EmailVerified)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">unverified</span>
                        }
                        @if (user.Phone != null)
                        {
                            <div class="small text-muted">@user.Phone</div>
                        }
                    </td>
                    <td>@user.Email</td>
                    <td>
                        <span class="badge @(user.Role == Role.SuperAdmin ? "bg-danger" : user.Role == Role.Admin ? "bg-warning text-dark" : "bg-secondary")">@user.Role</span>
                    </td>
                    <td>
                        @if (user.Status == UserStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-dark">@user.Status</span>
                        }
                    </td>
                    <td>@user.FailedLoginAttempts / 3</td>
                    <td>@(user.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "never")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="View details">👁</a>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Edit profile">✏️</a>
                        @if (!user.EmailVerified)
                        {
                            <form asp-action="Verify" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Verify email">✉️ Verify</button>
                            </form>
                        }
                        @if (isLocked)
                        {
                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success"
                                        title="Locked until @user.LockoutEnd?.ToString("dd MMM HH:mm")">🔓 Unlock</button>
                            </form>
                        }
                        @if (user.Role == Role.Member)
                        {
                            <form asp-action="SetStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                @if (user.Status == UserStatus.Active)
                                {
                                    <input type="hidden" name="status" value="Deactivated" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                }
                                else
                                {
                                    <input type="hidden" name="status" value="Active" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-2" aria-label="User pages">
        <ul class="pagination pagination-sm sh-pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-role="@Model.RoleFilter" asp-route-status="@Model.StatusFilter" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
