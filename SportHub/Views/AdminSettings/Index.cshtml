@model SystemSettingsViewModel
@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">⚙️ System Settings</h1>
    <span class="badge bg-danger badge-status">SuperAdmin only</span>
</div>

<p class="text-muted mt-2">
    These values drive the whole site: the navbar brand name and the announcement banner shown
    on every public page. Editing is restricted to the Super Admin role.
</p>

<div class="bh-card p-4 mt-3" style="max-width: 640px;">
    <form asp-action="Index" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="SiteName" class="form-label"></label>
            <input asp-for="SiteName" class="form-control" />
            <span asp-validation-for="SiteName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SiteAnnouncement" class="form-label"></label>
            <textarea asp-for="SiteAnnouncement" class="form-control" rows="2"></textarea>
            <span asp-validation-for="SiteAnnouncement" class="text-danger small"></span>
            <div class="form-text">Leave empty to hide the announcement banner.</div>
        </div>
        <button type="submit" class="btn btn-bh">Save Settings</button>
    </form>
</div>
