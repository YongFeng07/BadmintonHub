@model SportHub.ViewModels.AjaxListPage<SportHub.Models.DemoEmail>
@{
    ViewData["Title"] = "Demo Mail";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">📮 Demo Mail</h1>
</div>

<p class="text-muted mt-2">
    Outbound emails captured in-app. Rows appear while no SMTP host is configured in
    <code>appsettings.json</code> — this page lets the assignment demo show the verification,
    receipt and reminder emails exactly as they would arrive in a real inbox.
</p>

<div data-ajax-list data-url="@Url.Action("Index")">
    <form method="get" asp-action="Index" class="sh-form-section d-flex flex-wrap gap-2 align-items-center mb-3" data-ajax-filter>
        <div class="flex-grow-1" style="min-width: 220px;">
            <input type="text" name="search" class="form-control" placeholder="Search recipient or subject…" value="@Model.Pager.Search" />
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </form>

    <div data-ajax-target>
        <partial name="_MailTable" model="Model" />
    </div>
</div>
