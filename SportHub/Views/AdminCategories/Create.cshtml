@model SportHub.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Add Category";
    Layout = "_AdminLayout";
}

<div class="sh-admin-topbar">
    <div>
        <h2 class="sh-page-title mb-0">Add Category</h2>
        <p class="sh-page-sub mb-0">Create a new facility category for the catalog.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
