@model SportHub.ViewModels.AjaxListPage<SportHub.Models.Category>
@{
    // G-M6 AJAX list region for facility categories.
    var pager = Model.Pager;
}

@if (Model.Items.Count == 0)
{
    <div class="sh-empty"><span class="emoji">🔍</span>No categories match your search.</div>
}
else
{
    <div class="table-responsive sh-table">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 80px;">
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("order")"
                           aria-sort="@pager.AriaSortFor("order")">Order <span class="sh-sort-arrow">@pager.ArrowFor("order")</span></a>
                    </th>
                    <th>
                        <a class="sh-sort-link" data-ajax-sort href="@pager.SortLink("name")"
                           aria-sort="@pager.AriaSortFor("name")">Category <span class="sh-sort-arrow">@pager.ArrowFor("name")</span></a>
                    </th>
                    <th>Unit Label</th>
                    <th>Facilities</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Items)
                {
                    <tr>
                        <td class="text-muted">@category.DisplayOrder</td>
                        <td>
                            <strong>@category.Icon @category.Name</strong>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <div class="small text-muted">@category.Description</div>
                            }
                        </td>
                        <td><span class="badge badge-status" style="background:#eef3f8;color:#3c5670;">@category.UnitLabel</span></td>
                        <td>@category.Facilities.Count</td>
                        <td>
                            @if (category.Status == SportHub.Models.CategoryStatus.Active)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_AjaxPager" model="pager" />
