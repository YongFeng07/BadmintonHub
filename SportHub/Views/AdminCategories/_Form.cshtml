@model SportHub.ViewModels.CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<input asp-for="Id" type="hidden" />

<div class="sh-form-section">
    <h5 class="mb-3">Category Information</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Badminton Court" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitLabel" class="form-label"></label>
            <input asp-for="UnitLabel" class="form-control" placeholder="e.g. Court, Lane, Table" />
            <span asp-validation-for="UnitLabel" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Icon" class="form-label"></label>
            <input asp-for="Icon" class="form-control" placeholder="🏸" />
            <span asp-validation-for="Icon" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" type="number" min="1" />
            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Short description shown on catalog cards…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<SportHub.Models.CategoryStatus>()" class="form-select"></select>
        </div>
    </div>
</div>

<button type="submit" class="btn btn-sh px-4">Save Category</button>
<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
