@model SportHub.ViewModels.CourtFormViewModel
@{
    ViewData["Title"] = "Edit Court";
    Layout = "_AdminLayout";
}

<div class="sh-admin-topbar">
    <div>
        <h2 class="sh-page-title mb-0">Edit Court @Model.CourtNumber</h2>
        <p class="sh-page-sub mb-0">Update court details and pricing.</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
