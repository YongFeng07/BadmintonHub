@model SportHub.ViewModels.CourtFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<input asp-for="Id" type="hidden" />

<div class="sh-form-section">
    <h5 class="mb-3">Court Information</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="FacilityId" class="form-label"></label>
            <select asp-for="FacilityId" class="form-select">
                <option value="0">— Select a facility —</option>
                @foreach (var facility in Model.Facilities)
                {
                    <option value="@facility.Id">@facility.Name</option>
                }
            </select>
            <span asp-validation-for="FacilityId" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="CourtNumber" class="form-label"></label>
            <input asp-for="CourtNumber" class="form-control" placeholder="e.g. 07" />
            <span asp-validation-for="CourtNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CourtType" class="form-label"></label>
            <select asp-for="CourtType" asp-items="Html.GetEnumSelectList<SportHub.Models.CourtType>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<SportHub.Models.CourtStatus>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="HourlyRate" class="form-label"></label>
            <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="HourlyRate" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Flooring, lighting, amenities…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
    </div>
</div>

<button type="submit" class="btn btn-sh px-4">Save Court</button>
<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
