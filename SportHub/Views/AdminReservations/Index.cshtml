@model AdminReservationsIndexViewModel
@{
    ViewData["Title"] = "Reservation Administration";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h3 mb-0">📋 Reservation Administration</h1>
    <span class="text-muted">@Model.TotalCount reservation(s)</span>
</div>

<div class="sh-form-section mt-3">
    <form id="filterForm" asp-action="Table" method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Reference, member name or email" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<ReservationStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s.ToString() ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Court</label>
            <select name="courtId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var court in Model.Courts)
                {
                    <option value="@court.Id" selected="@(Model.CourtId == court.Id ? "selected" : null)">Court @court.CourtNumber</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Date</label>
            <input type="date" name="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Sort</label>
            <select name="sort" class="form-select form-select-sm">
                <option value="date_desc" selected="@(Model.Sort == "date_desc" ? "selected" : null)">Date (newest)</option>
                <option value="date_asc" selected="@(Model.Sort == "date_asc" ? "selected" : null)">Date (oldest)</option>
                <option value="amount_desc" selected="@(Model.Sort == "amount_desc" ? "selected" : null)">Amount (highest)</option>
                <option value="created_desc" selected="@(Model.Sort == "created_desc" ? "selected" : null)">Created (newest)</option>
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-sh btn-sm">Filter</button>
        </div>
    </form>
    @if (Model.HasFilter)
    {
        <a asp-action="Index" class="small mt-2 d-inline-block">Clear all filters</a>
    }
</div>

<div id="resTableContainer" class="mt-3">
    <partial name="_Table" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin-reservations.js" asp-append-version="true"></script>
}
