@model SportHub.ViewModels.HomeViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Home";
}

<div class="bh-hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-5 mb-3">@Localizer["HeroTitle1"]<br /><span class="bh-hero-accent">@Localizer["HeroTitle2"]</span></h1>
            <p class="lead mb-4">@Localizer["HeroLead", Model.Facility?.Name ?? "SportHub"]</p>
            <a asp-controller="Courts" asp-action="Index" class="btn btn-bh-amber btn-lg px-4 me-2">@Localizer["HeroBrowse"]</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-light btn-lg px-4 me-2">@Localizer["HeroFacilities"]</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Courts" asp-action="Index" class="btn btn-outline-light btn-lg px-4">@Localizer["HeroCheck"]</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4">@Localizer["HeroLogin"]</a>
            }
        </div>
        <div class="col-lg-4 d-none d-lg-block text-end">
            <span style="font-size: 7rem; opacity: .9;">🏸</span>
        </div>
    </div>
    <div class="row g-3 mt-4">
        <div class="col-6 col-md-3">
            <div class="bh-stat"><span class="number">@Model.CourtCount</span><span class="label">@Localizer["StatCourts"]</span></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bh-stat"><span class="number">@Model.MemberCount</span><span class="label">@Localizer["StatMembers"]</span></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bh-stat"><span class="number">@Model.TodayReservations</span><span class="label">@Localizer["StatToday"]</span></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bh-stat"><span class="number">8–23</span><span class="label">@Localizer["StatHours"]</span></div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="bh-page-title mb-0">@Localizer["OurCourts"]</h2>
    <a asp-controller="Courts" asp-action="Index" class="btn btn-bh btn-sm">@Localizer["ViewAll"]</a>
</div>

<div class="row g-4">
    @foreach (var court in Model.FeaturedCourts)
    {
        var primaryPhoto = court.Photos.OrderBy(p => p.DisplayOrder).FirstOrDefault();
        <div class="col-md-6 col-lg-4">
            <div class="card bh-card bh-court-card h-100">
                @if (primaryPhoto != null)
                {
                    <img src="@primaryPhoto.FilePath" class="card-img-top" alt="Court @court.CourtNumber" />
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">Court @court.CourtNumber</h5>
                        <span class="badge badge-status badge-@court.CourtType.ToString().ToLower()" style="background:#eef3f8;color:#3c5670;">@court.CourtType</span>
                    </div>
                    <p class="text-muted small mb-3">
                        @(string.IsNullOrEmpty(court.Description) ? Localizer["CourtDefault"] : court.Description.Length > 90 ? court.Description[..90] + "…" : court.Description)
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-bh-green">RM @court.HourlyRate.ToString("0.00") <span class="text-muted fw-normal">@Localizer["PerHour"]</span></span>
                        <a asp-controller="Courts" asp-action="Details" asp-route-id="@court.Id" class="btn btn-bh btn-sm">@Localizer["ViewCourt"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Facility != null)
{
    <div class="bh-form-section mt-5 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h4 class="mb-1">📍 @Model.Facility.Name</h4>
            <p class="mb-0 text-muted">@Model.Facility.Address · @Localizer["OpenDaily"] @Model.Facility.OpeningTime.ToString(@"hh\:mm") – @Model.Facility.ClosingTime.ToString(@"hh\:mm")</p>
        </div>
        <a asp-controller="Facility" asp-action="Index" class="btn btn-outline-success flex-shrink-0">@Localizer["AboutFacility"]</a>
    </div>
}
