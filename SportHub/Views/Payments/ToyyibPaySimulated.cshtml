@model ToyyibPaySimulatedViewModel
@{
    ViewData["Title"] = "Payment Gateway (Demo)";
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

@* Simulated ToyyibPay fallback page. It deliberately looks like an external
   hosted payment page so the demo flow reads as "member → gateway → back".
   No real payment happens: the buttons just play the gateway's status_id. *@
<div class="mt-3 d-flex justify-content-center">
    <div class="sim-gateway" style="max-width: 520px;">
        <div class="sim-gateway-header">
            <span class="sim-gateway-brand">🧾 ToyyibPay <small>(Simulated Demo)</small></span>
            <span class="badge bg-warning text-dark">TEST MODE</span>
        </div>

        <div class="sim-gateway-body">
            <h1 class="h5 mb-1">Payment for SportHub</h1>
            <p class="text-muted small mb-3">
                Bill code <strong>@Model.BillCode</strong> &middot;
                @Model.Reservations.Count reservation(s)
            </p>

            <div class="sim-gateway-amount">
                <span class="text-muted small d-block">Amount due</span>
                <span class="display-6 fw-bold">RM @Model.Amount.ToString("0.00")</span>
            </div>

            <div class="small border-top pt-3 mt-3">
                @foreach (var r in Model.Reservations)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span>@r.ReservationReference — Court @r.Court?.CourtNumber</span>
                        <span class="text-muted">@r.ReservationDate.ToString("dd MMM") @r.StartTime.ToString("HH:mm")</span>
                    </div>
                }
            </div>

            <form asp-action="ToyyibPaySimulate" method="post" class="mt-3">
                <input type="hidden" name="billCode" value="@Model.BillCode" />
                <button type="submit" name="action" value="pay" class="btn btn-success w-100">
                    ✓ Pay Now
                </button>
                <button type="submit" name="action" value="cancel" class="btn btn-outline-secondary w-100 mt-2">
                    Cancel Payment
                </button>
            </form>

            <p class="small text-muted mt-3 mb-0">
                ⚠️ <strong>Simulated payment page.</strong> No real money changes hands.
                In a production deployment this page is replaced by the hosted ToyyibPay
                checkout once real credentials are configured (see appsettings.json).
            </p>
        </div>
    </div>
</div>

<style>
    .sim-gateway {
        border: 1px solid #d9e2de;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(14, 58, 47, .12);
        background: #fff;
    }
    .sim-gateway-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        background: #0e3a2f;
        color: #fff;
    }
    .sim-gateway-brand { font-weight: 700; letter-spacing: .3px; }
    .sim-gateway-brand small { font-weight: 400; opacity: .85; }
    .sim-gateway-body { padding: 24px 24px 20px; }
    .sim-gateway-amount {
        background: #f2f6f4;
        border-radius: 10px;
        padding: 14px 18px;
        text-align: center;
        color: #0e3a2f;
    }
</style>
