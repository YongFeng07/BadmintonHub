@model SportHub.ViewModels.FacilityEditViewModel
@{
    ViewData["Title"] = "Edit Facility";
    Layout = "_AdminLayout";
}

<div class="bh-admin-topbar">
    <div>
        <h2 class="bh-page-title mb-0">Edit Facility</h2>
        <p class="bh-page-sub mb-0">@Model.Name</p>
    </div>
    <a asp-action="ManagePhotos" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Manage Photos</a>
</div>

<form asp-action="Edit" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
