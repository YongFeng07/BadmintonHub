@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="sh-card p-4">
            <h1 class="h4 mb-1">Choose a new password</h1>
            <p class="text-muted small mb-3">
                @if (ViewBag.UserEmail != null)
                {
                    <span>Resetting the password for <strong>@ViewBag.UserEmail</strong>.</span>
                }
                else
                {
                    <span>This link looks invalid.</span>
                }
            </p>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-sh w-100">Reset Password</button>
            </form>
            <p class="small mt-3 mb-0 text-center">
                <a asp-action="Login">Back to login</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
