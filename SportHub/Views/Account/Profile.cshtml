@model EditProfileViewModel
@inject ApplicationDbContext Db
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "My Profile";
    var changeModel = ViewBag.ChangePasswordModel as ChangePasswordViewModel ?? new ChangePasswordViewModel();
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var photoUrl = int.TryParse(uid, out var parsedId)
        ? await Db.Users.Where(u => u.Id == parsedId).Select(u => u.PhotoUrl).FirstOrDefaultAsync()
        : null;
    var initials = string.Concat(Model.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => char.ToUpperInvariant(w[0]))
        .Take(2));
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-7">
        <div class="sh-form-section">
            <h1 class="h4 mb-3">👤 @Localizer["Title"]</h1>

            <div class="d-flex align-items-center gap-4 flex-wrap mb-4">
                @if (photoUrl != null)
                {
                    <img src="@photoUrl" alt="Profile photo" class="sh-avatar-lg" />
                }
                else
                {
                    <span class="sh-avatar-lg sh-avatar-initials">@initials</span>
                }
                <div>
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data"
                          class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp"
                               class="form-control form-control-sm" style="max-width: 260px" />
                        <button type="submit" class="btn btn-sh btn-sm">@Localizer["UploadPhoto"]</button>
                    </form>
                    @if (photoUrl != null)
                    {
                        <form asp-action="RemovePhoto" method="post" class="mt-2">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["RemovePhoto"]</button>
                        </form>
                    }
                    <div class="small text-muted mt-1">@Localizer["PhotoHint"]</div>
                </div>
            </div>

            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-sh">@Localizer["SaveProfile"]</button>
            </form>
        </div>

        <div class="sh-form-section mt-4">
            <h2 class="h5 mb-3">🔒 @Localizer["ChangePasswordTitle"]</h2>
            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="@changeModel.CurrentPassword" class="form-label"></label>
                        <input asp-for="@changeModel.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="@changeModel.CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="@changeModel.NewPassword" class="form-label"></label>
                        <input asp-for="@changeModel.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="@changeModel.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="@changeModel.ConfirmPassword" class="form-label"></label>
                        <input asp-for="@changeModel.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="@changeModel.ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-success">@Localizer["ChangePasswordBtn"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
