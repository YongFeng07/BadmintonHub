@model VerifyEmailSentViewModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="sh-card p-4 p-md-5 text-center mt-5">
            <div class="sh-verify-icon">📬</div>

            @if (Model.AlreadyVerified)
            {
                <h1 class="h4 mb-2">Email already verified</h1>
                <p class="text-muted">Your email address is already verified. You can sign in now.</p>
                <a asp-action="Login" class="btn btn-sh mt-2">Back to login</a>
            }
            else
            {
                <h1 class="h4 mb-2">Check your inbox</h1>
                <p class="text-muted mb-4">
                    We sent a verification link to
                    <strong class="text-break">@Model.Email</strong>.
                    Click it to activate your account.
                </p>

                @if (Model.Link != null)
                {
                    <div class="alert alert-warning text-start small">
                        <strong>Demo note:</strong> no email service is configured, so the
                        verification link is shown here instead of being mailed:
                        <div class="mt-1 text-break"><a href="@Model.Link">@Model.Link</a></div>
                    </div>
                }

                <p class="small text-muted">
                    Did not receive the email?
                    <a asp-action="ResendVerification" asp-route-email="@Model.Email">Resend it</a>
                </p>
                <a asp-action="Login" class="btn btn-sh">Back to login</a>
            }
        </div>
    </div>
</div>
