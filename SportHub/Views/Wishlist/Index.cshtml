@model List<SportHub.Models.WishlistItem>
@{
    ViewData["Title"] = "My Wishlist";
}
<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<div class="mt-3">
    <h1 class="h3 mb-1">❤️ My Wishlist</h1>
    <p class="text-muted mb-3">Courts you saved — book them as soon as they open up.</p>

    @if (Model.Count == 0)
    {
        <div class="bh-form-section">
            <div class="bh-empty">
                <span class="emoji">❤️</span>
                Your wishlist is empty. Unavailable courts offer “Add to Wishlist” on their detail page.
            </div>
            <div class="text-center">
                <a asp-controller="Courts" asp-action="Index" class="btn btn-bh">Browse Courts</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                var court = item.Court!;
                <div class="col-md-6 col-lg-4">
                    <div class="bh-form-section h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-0">Court @court.CourtNumber</h5>
                                <div class="small text-muted">@court.Facility?.Name</div>
                            </div>
                            @if (court.Status == SportHub.Models.CourtStatus.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@court.Status</span>
                            }
                        </div>
                        <div class="small text-muted mt-2">
                            RM @court.HourlyRate.ToString("0.00")/hr · @court.CourtType ·
                            Added @item.AddedAt.ToString("dd MMM yyyy")
                        </div>
                        <div class="d-flex gap-2 mt-auto pt-3">
                            @if (court.Status == SportHub.Models.CourtStatus.Available)
                            {
                                <a asp-controller="Reservations" asp-action="Create" asp-route-courtId="@court.Id"
                                   class="btn btn-bh btn-sm flex-fill">Book Now</a>
                            }
                            else
                            {
                                <a asp-controller="Courts" asp-action="Details" asp-route-id="@court.Id"
                                   class="btn btn-outline-secondary btn-sm flex-fill">View Court</a>
                            }
                            <form asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        title="Remove from wishlist" aria-label="Remove from wishlist">✕</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
