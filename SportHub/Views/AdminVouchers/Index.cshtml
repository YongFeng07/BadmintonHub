@model List<SportHub.Models.Voucher>
@{
    ViewData["Title"] = "Discount Vouchers";
    Layout = "_AdminLayout";
}

<div class="bh-admin-topbar">
    <div>
        <h2 class="bh-page-title mb-0">Discount Vouchers</h2>
        <p class="bh-page-sub mb-0">@Model.Count voucher(s) — applied by members at cart checkout.</p>
    </div>
    <a asp-action="Create" class="btn btn-bh">+ Add Voucher</a>
</div>

<div class="table-responsive bh-table">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Discount</th>
                <th>Expiry</th>
                <th>Used</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var voucher in Model)
            {
                var expired = voucher.ExpiryDate < DateOnly.FromDateTime(DateTime.Today);
                var limitReached = voucher.UsageLimit.HasValue && voucher.UsageCount >= voucher.UsageLimit.Value;
                <tr>
                    <td><strong class="font-monospace">@voucher.Code</strong></td>
                    <td>@voucher.Description</td>
                    <td>
                        @if (voucher.DiscountType == SportHub.Models.DiscountType.Percentage)
                        {
                            <span class="badge badge-status" style="background:#eef3f8;color:#3c5670;">
                                @voucher.DiscountValue.ToString("0.##")% off
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-status" style="background:#eef3f8;color:#3c5670;">
                                RM @voucher.DiscountValue.ToString("0.00") off
                            </span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @voucher.ExpiryDate.ToString("dd MMM yyyy")
                        @if (expired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                    </td>
                    <td>
                        @voucher.UsageCount@(voucher.UsageLimit.HasValue ? $" / {voucher.UsageLimit}" : "")
                        @if (limitReached)
                        {
                            <span class="badge bg-warning text-dark">Limit reached</span>
                        }
                    </td>
                    <td>
                        @if (voucher.Status == SportHub.Models.VoucherStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@voucher.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@voucher.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
