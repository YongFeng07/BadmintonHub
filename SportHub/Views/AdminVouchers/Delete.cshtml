@model SportHub.Models.Voucher
@{
    ViewData["Title"] = "Delete Voucher";
    Layout = "_AdminLayout";
}

<div class="sh-form-section" style="max-width: 560px;">
    <h2 class="sh-page-title mb-1">Delete Voucher?</h2>
    <p class="sh-page-sub mb-3">
        Voucher <strong class="font-monospace">@Model.Code</strong>
        (@Model.UsageCount time(s) used) will be permanently deleted.
    </p>
    <p class="small text-muted">
        Bookings that used this voucher keep the code on their reservation record, so
        payment history stays intact.
    </p>
    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete Voucher</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
